<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Duarte Meire - Calçados e Acessórios</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uikit@3.21.6/dist/css/uikit.min.css" />
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- BARRA SUPERIOR -->
    <div class="top-bar uk-light uk-padding-small">
        <div class="uk-container uk-flex uk-flex-between uk-text-small">
            <div>
                <span class="uk-margin-right">Parcele em até 6x sem juros</span>
                <span>5% OFF NO PIX</span>
            </div>
            <div>
                <span class="uk-margin-right">Atendimento</span>
                <span>(85) 99292-2434</span>
            </div>
        </div>
    </div>

    <!-- HEADER LOGO E BUSCA -->
    <header class="uk-background-default uk-padding">
        <div class="uk-container uk-flex uk-flex-between uk-flex-middle">
            <div class="uk-width-1-4">
                <div class="uk-inline uk-width-1-1">
                    <span class="uk-form-icon" uk-icon="icon: search"></span>
                    <input class="uk-input uk-form-rounded" type="text" placeholder="O que você procura?">
                </div>
            </div>
            <div class="uk-text-center">
                <h1 style="font-family: serif; margin:0;">DUARTE MEIRE</h1>
                <small class="uk-text-uppercase" style="letter-spacing: 2px;">Calçados e Acessórios</small>
            </div>
                <div class="uk-width-1-4 uk-text-right">

                    <!-- Desktop: ícone + texto -->
                    <a href="#" class="uk-visible@m uk-margin-small-right" uk-icon="user">
                        Minha conta
                    </a>

                    <!-- Mobile: apenas ícone arredondado -->
                    <a href="#" class="uk-hidden@m uk-icon-button uk-margin-small-right" uk-icon="user"></a>

                    <!-- Carrinho -->
                    <a href="#" class="uk-visible@m" uk-icon="cart"> (0)</a>
                    <a href="#" class="uk-hidden@m uk-icon-button" uk-icon="cart"></a>

                </div>
        </div>
    </header>

    <!-- Botão hamburguer sempre visível -->
    <div class="uk-text-center uk-padding-small">
    <button class="uk-button uk-button-default" type="button" uk-toggle="target: #offcanvas-nav">
        <span uk-icon="menu"></span> Menu
    </button>
    </div>

    <!-- Offcanvas menu -->
    <div id="offcanvas-nav" uk-offcanvas="overlay: true">
    <div class="uk-offcanvas-bar">
        <button class="uk-offcanvas-close" type="button" uk-close></button>
        <ul class="uk-nav uk-nav-default">

        <li><a href="#"><span uk-icon="star" class="uk-margin-small-right"></span> NOVIDADES</a></li>
        <li><a href="#"><span uk-icon="tag" class="uk-margin-small-right"></span> CALÇADOS</a></li>
        <li><a href="#"><span uk-icon="bag" class="uk-margin-small-right"></span> BOLSAS</a></li>
        <li><a href="#"><span uk-icon="heart" class="uk-margin-small-right"></span> ACESSÓRIOS</a></li>
        <li><a href="#"><span uk-icon="credit-card" class="uk-margin-small-right"></span> PROMOÇÕES</a></li>
        <li><a href="#"><span uk-icon="mail" class="uk-margin-small-right"></span> CONTATO</a></li>

        </ul>
    </div>
    </div>

    <!-- BANNER PRINCIPAL (HERO) -->
    <section class="hero-section uk-flex uk-flex-middle uk-background-cover" 
             style="background-image: url('/img/banner.png'); min-height: 500px;">
        <div class="uk-container uk-width-1-1">
            <div class="uk-width-xlarge@m uk-width-1-1">
                <p style="color: var(--marrom-texto); letter-spacing: 2px; font-weight: 500;" class="uk-text-uppercase uk-margin-remove-bottom">
                    Novos Lançamentos
                </p>
                <h2 class="uk-heading-small uk-margin-small-top" style="font-family: 'Playfair Display', serif; color: #333; line-height: 1.2;">
                    Elegância que <br><i style="font-family: serif;">te acompanha</i>
                </h2>
                <p class="uk-text-lead uk-margin-medium-bottom" style="font-size: 1.2rem; color: #555;">
                    Calçados e bolsas selecionados para <br class="uk-visible@m">
                    mulheres que valorizam estilo e conforto.
                </p>
                <!-- Botão com efeito de diminuir no hover -->
                <a href="#" class="uk-button btn-primary uk-button-large" style="padding: 0 50px; font-weight: bold; letter-spacing: 1px;">
                    COMPRE AGORA
                </a>
            </div>
        </div>
    </section>   

    <!-- BARRA DE BENEFÍCIOS -->
  <div class="uk-section uk-section-xsmall uk-background-default">
    <div class="uk-container">
        <div class="uk-grid-divider uk-child-width-1-3@m uk-text-center" uk-grid>

        <div>
            <span uk-icon="icon: bolt; ratio: 1.2" class="uk-margin-small-right"></span>
            ENTREGA FÁCIL - Facilidade e agilidade na entrega
        </div>

        <div>
            <span uk-icon="icon: credit-card; ratio: 1.2" class="uk-margin-small-right"></span>
            PARCELE EM ATÉ 6X - Sem juros no cartão
        </div>

        <div>
            <span uk-icon="icon: lock; ratio: 1.2" class="uk-margin-small-right"></span>
            COMPRA SEGURA - Seus dados protegidos
        </div>

        </div>
    </div>
    </div>

    <!-- GRID DE PRODUTOS -->
    <section class="uk-section">
        <div class="uk-container">
            <h3 class="uk-text-center uk-text-uppercase uk-margin-large-bottom">Destaques</h3>
            <div class="uk-grid-medium uk-child-width-1-4@m uk-child-width-1-2" uk-grid>
                
                <!-- Exemplo de como deve ficar cada item do seu grid -->
            <div>
                <div class="uk-card uk-text-center hover-shrink">
                    <div class="uk-inline uk-width-1-1">
                        <span class="uk-badge uk-position-top-left product-badge" style="z-index: 1;">NOVO</span>
                        
                        <!-- Div que controla o tamanho fixo -->
                        <div class="uk-cover-container product-image-container">
                            <img src="/img/bolsa01.jpeg" alt="Bolsa" uk-cover>
                            <!-- O atributo uk-cover faz a imagem se comportar como background-cover -->
                        </div>
                    </div>
                    
                    <div class="uk-padding-small">
                        <p class="uk-margin-remove uk-text-truncate">Bolsa Tote Clássica Caramelo</p>
                        <p class="uk-text-bold uk-margin-remove">R$ 129,90</p>
                        <p class="uk-text-meta">6x de R$ 33,31 sem juros</p>
                    </div>
                </div>
            </div>

            <div>
                <div class="uk-card uk-text-center hover-shrink">
                    <div class="uk-inline uk-width-1-1">
                        <span class="uk-badge uk-position-top-left product-badge" style="z-index: 1;">NOVO</span>
                        
                        <!-- Div que controla o tamanho fixo -->
                        <div class="uk-cover-container product-image-container">
                            <img src="/img/bolsa02.jpeg" alt="Bolsa" uk-cover>
                            <!-- O atributo uk-cover faz a imagem se comportar como background-cover -->
                        </div>
                    </div>
                    
                    <div class="uk-padding-small">
                        <p class="uk-margin-remove uk-text-truncate">Bolsa Tote Clássica Caramelo</p>
                        <p class="uk-text-bold uk-margin-remove">R$ 129,90</p>
                        <p class="uk-text-meta">6x de R$ 33,31 sem juros</p>
                    </div>
                </div>
            </div>

            <div>
                <div class="uk-card uk-text-center hover-shrink">
                    <div class="uk-inline uk-width-1-1">
                        <span class="uk-badge uk-position-top-left product-badge" style="z-index: 1;">NOVO</span>
                        
                        <!-- Div que controla o tamanho fixo -->
                        <div class="uk-cover-container product-image-container">
                            <img src="/img/sandalia.jpeg" alt="Bolsa" uk-cover>
                            <!-- O atributo uk-cover faz a imagem se comportar como background-cover -->
                        </div>
                    </div>
                    
                    <div class="uk-padding-small">
                        <p class="uk-margin-remove uk-text-truncate">Bolsa Tote Clássica Caramelo</p>
                        <p class="uk-text-bold uk-margin-remove">R$ 129,90</p>
                        <p class="uk-text-meta">6x de R$ 33,31 sem juros</p>
                    </div>
                </div>
            </div>


            <div>
                <div class="uk-card uk-text-center hover-shrink">
                    <div class="uk-inline uk-width-1-1">
                        <span class="uk-badge uk-position-top-left product-badge" style="z-index: 1;">NOVO</span>
                        
                        <!-- Div que controla o tamanho fixo -->
                        <div class="uk-cover-container product-image-container">
                            <img src="/img/sandalia02.jpeg" alt="Bolsa" uk-cover>
                            <!-- O atributo uk-cover faz a imagem se comportar como background-cover -->
                        </div>
                    </div>
                    
                    <div class="uk-padding-small">
                        <p class="uk-margin-remove uk-text-truncate">Bolsa Tote Clássica Caramelo</p>
                        <p class="uk-text-bold uk-margin-remove">R$ 129,90</p>
                        <p class="uk-text-meta">6x de R$ 33,31 sem juros</p>
                    </div>
                </div>
            </div>

            </div>
            <div class="uk-text-center uk-margin-large-top">
                <button class="uk-button btn-primary">VER TODOS</button>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.21.6/dist/js/uikit.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/uikit@3.21.6/dist/js/uikit-icons.min.js"></script>
</body>
</html>